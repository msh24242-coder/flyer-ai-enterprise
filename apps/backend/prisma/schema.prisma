generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), vector]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MemoryType {
  DECISION
  CAMPAIGN_INSIGHT
  LEARNED_PREFERENCE
  GOAL_UPDATE
  LESSON
}

enum PermissionLevel {
  READ
  WRITE
  APPROVAL_REQUIRED
  ADMIN_ONLY
}

enum ApprovalStatus {
  PENDING
  GRANTED
  DENIED
  EXPIRED
}

enum AgentType {
  DIRECTOR
  STRATEGY
  RESEARCH
  CONTENT
  SOCIAL
  PERFORMANCE
  ANALYTICS
  CREATIVE
}

enum AgentTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PENDING_AGENT
  CANCELLED
}

enum AgentExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  PENDING_APPROVAL
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum FlyerStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String
  slug      String   @unique
  industry  String?
  website   String?
  logoUrl   String?
  aiConfig  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  conversations    Conversation[]
  goals            MarketingGoal[]
  campaigns        Campaign[]
  tasks            Task[]
  companyKnowledge CompanyKnowledge[]
  agentMemory      AgentMemory[]
  agentTasks       AgentTask[]
  generatedContent GeneratedContent[]
  agentExecutions  AgentExecution[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]
  products         Product[]
  assets           Asset[]
  flyers           Flyer[]

  @@map("companies")
}

model User {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole  @default(MEMBER)
  companyId           String    @db.Uuid
  refreshTokenHash    String?
  lastLoginAt         DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  assignedTasks Task[]         @relation("AssignedTasks")
  auditLogs     AuditLog[]
  approvals     ApprovalRequest[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Conversation {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId    String             @db.Uuid
  userId       String             @db.Uuid
  agentType    AgentType          @default(DIRECTOR)
  title        String?
  status       ConversationStatus @default(ACTIVE)
  totalCostUsd Float              @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id])
  messages         Message[]
  agentExecutions  AgentExecution[]
  approvalRequests ApprovalRequest[]

  @@index([companyId, status])
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String   @db.Uuid
  role           String   // "user" | "assistant" | "tool"
  content        Json
  tokenCount     Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MarketingGoal {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String     @db.Uuid
  title       String
  description String?
  status      GoalStatus @default(DRAFT)
  targetDate  DateTime?
  metrics     Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([companyId, status])
  @@map("marketing_goals")
}

model Campaign {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String         @db.Uuid
  goalId      String?        @db.Uuid
  title       String
  description String?
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goal             MarketingGoal?    @relation(fields: [goalId], references: [id])
  tasks            Task[]
  generatedContent GeneratedContent[]
  flyers           Flyer[]

  @@index([companyId, status])
  @@index([goalId])
  @@map("campaigns")
}

model Task {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId    String       @db.Uuid
  campaignId   String?      @db.Uuid
  assignedToId String?      @db.Uuid
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  assignedTo User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([companyId, status])
  @@index([campaignId])
  @@index([assignedToId])
  @@map("tasks")
}

model CompanyKnowledge {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String   @db.Uuid
  category    String
  key         String
  value       Json
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, category, key])
  @@index([companyId, category])
  @@map("company_knowledge")
}

model AgentMemory {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String     @db.Uuid
  agentType   AgentType
  memoryType  MemoryType
  content     String
  embedding   Unsupported("vector(1024)")?
  importance  Float      @default(0.5)
  accessCount Int        @default(0)
  lastAccessedAt DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, agentType, memoryType])
  @@map("agent_memory")
}

model AgentExecution {
  id               String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  traceId          String               @unique
  companyId        String               @db.Uuid
  userId           String?              @db.Uuid
  conversationId   String?              @db.Uuid
  agentType        AgentType
  model            String
  status           AgentExecutionStatus @default(RUNNING)
  inputTokens      Int                  @default(0)
  outputTokens     Int                  @default(0)
  estimatedCostUsd Float                @default(0)
  totalLatencyMs   Int?
  iterations       Int                  @default(1)
  errorMessage     String?
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  createdAt        DateTime             @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation?  @relation(fields: [conversationId], references: [id])
  toolCallLogs ToolCallLog[]

  @@index([companyId])
  @@index([conversationId])
  @@index([traceId])
  @@map("agent_executions")
}

model ToolCallLog {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agentExecutionId String          @db.Uuid
  toolCallId       String
  toolName         String
  permissionLevel  PermissionLevel
  input            Json
  output           Json?
  isError          Boolean         @default(false)
  wasApproved      Boolean         @default(true)
  durationMs       Int?
  createdAt        DateTime        @default(now())

  agentExecution AgentExecution @relation(fields: [agentExecutionId], references: [id])

  @@index([agentExecutionId])
  @@map("tool_call_logs")
}

model ApprovalRequest {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId        String          @db.Uuid
  conversationId   String?         @db.Uuid
  requestedById    String?         @db.Uuid
  agentExecutionId String?
  toolName         String
  toolInput        Json
  permissionLevel  PermissionLevel
  status           ApprovalStatus  @default(PENDING)
  reviewedById     String?         @db.Uuid
  reviewNote       String?
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  requestedBy  User?         @relation(fields: [requestedById], references: [id])

  @@index([companyId, status])
  @@index([conversationId, status])
  @@map("approval_requests")
}

model AgentTask {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId        String          @db.Uuid
  requestedByAgent AgentType
  targetAgent      AgentType
  status           AgentTaskStatus @default(QUEUED)
  payload          Json
  conversationId   String?         @db.Uuid
  parentTaskId     String?         @db.Uuid
  result           Json?
  errorMessage     String?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentTask AgentTask? @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks   AgentTask[] @relation("SubTasks")

  @@index([companyId, status])
  @@map("agent_tasks")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId  String   @db.Uuid
  userId     String?  @db.Uuid
  traceId    String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([traceId])
  @@map("audit_logs")
}

model GeneratedContent {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId       String    @db.Uuid
  agentType       AgentType
  contentType     String
  title           String?
  content         String
  metadata        Json?
  campaignId      String?   @db.Uuid
  agentExecutionId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([companyId, contentType])
  @@index([companyId, agentType])
  @@map("generated_content")
}

model Product {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId     String   @db.Uuid
  createdBy     String   @db.Uuid
  sku           String
  name          String
  description   String?
  basePrice     Float
  costPrice     Float?
  currency      String   @default("QAR")
  stockQuantity Int?
  category      String?
  tags          String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flyerProducts FlyerProduct[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@map("products")
}

model Asset {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId     String   @db.Uuid
  uploadedBy    String   @db.Uuid
  filename      String
  mimeType      String
  fileSizeBytes Int
  storagePath   String
  publicUrl     String
  tags          String[] @default([])
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("assets")
}

model Flyer {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String      @db.Uuid
  createdBy   String      @db.Uuid
  title       String
  slug        String
  status      FlyerStatus @default(DRAFT)
  designData  Json        @default("{}")
  thumbnail   String?
  campaignId  String?     @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  flyerProducts FlyerProduct[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([campaignId])
  @@map("flyers")
}

model FlyerProduct {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  flyerId       String   @db.Uuid
  productId     String   @db.Uuid
  displayPrice  Float?
  originalPrice Float?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  flyer   Flyer   @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flyerId, productId])
  @@index([flyerId, sortOrder])
  @@map("flyer_products")
}
