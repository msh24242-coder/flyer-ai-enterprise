# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (pgvector image required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketing_os_dev?schema=public"
# Used by Prisma Studio and direct migrations (same as DATABASE_URL for local dev)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/marketing_os_dev?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: Minimum 64 random bytes (hex)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_BYTE_HEX_STRING"
JWT_EXPIRES_IN="15m"

# REQUIRED: Different from JWT_SECRET — minimum 64 random bytes (hex)
REFRESH_TOKEN_SECRET="REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── AI Providers ────────────────────────────────────────────────────────────
# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Voyage AI for embeddings (voyage.ai)
# If not set, embeddings degrade gracefully (semantic search unavailable)
VOYAGE_API_KEY=""

# Provider selection (defaults shown)
AI_PROVIDER="anthropic"
EMBEDDING_PROVIDER="voyage"
AI_MODEL="claude-opus-5"

# ─── Server ──────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
NODE_ENV="development"

# CORS — frontend URL
FRONTEND_URL="http://localhost:3000"

# ─── Budget Controls (optional) ──────────────────────────────────────────────
# Maximum USD per company per month (0 = no limit)
DEFAULT_MONTHLY_BUDGET_USD=0
# Maximum USD per single agent execution
MAX_EXECUTION_COST_USD=5.00
