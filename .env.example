# =============================================================================
# AI Marketing OS — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER put real secrets in this file — it IS committed to git.
# =============================================================================

NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/marketing_os_dev
# Direct connection (bypasses PgBouncer if used)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/marketing_os_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Generate: openssl rand -hex 64   (must differ from JWT_SECRET)
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── AI Providers ────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic          # anthropic | openai | gemini
AI_MODEL=claude-sonnet-5-20251001
EMBEDDING_PROVIDER=voyage      # voyage | openai
EMBEDDING_MODEL=voyage-3-lite  # 1024 dimensions

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# ─── App URLs ────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Optional: Supabase ──────────────────────────────────────────────────────
# Only needed if using Supabase-hosted PostgreSQL
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
